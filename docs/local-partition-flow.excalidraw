      "id": "note_text",
      "x": 120, "y": 650,
      "width": 720, "height": 38,
      "text": "No serialization needed — vectors stay in memory via LocalExchangeQueue\nVelox handles partitioning, backpressure, and memory internally",
      "originalText": "No serialization needed — vectors stay in memory via LocalExchangeQueue\nVelox handles partitioning, backpressure, and memory internally",
